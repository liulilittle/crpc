# OS
Thumbs.db
Desktop.ini
.DS_Store

# Working memory and private design material (kept local, not published)
.opencode/
.superpowers/

# Third-party checkouts fetched by CMake
_deps/
third_party/_fetched/

# Local scratch
tmp/
scratch/

# Redis Sentinel/Replica configs written while exercising the client against
# a local 6380/6381/26380 setup; they are machine-local, not part of the build.
replica.conf
sentinel.conf

# Test-run artifacts that must never be committed
obs_rotation.log*
*.dmp
crash-*.txt

# Python bytecode from scripts/export_gate.py
__pycache__/
*.pyc

.worktrees/


# Local source-tree snapshots produced while investigating a branch
.snaps/
